{
  "name": "carpan-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "bridge:check-mainnet": "bun run scripts/check-bridge-mainnet.ts",
    "check": "bash scripts/check.sh",
    "test": "bun test --parallel=5 server",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "test:chain": "bun test server/chain.test.ts",
    "test:auth": "bun test server/oauth.test.ts",
    "test:login": "bun test server/alternativeAuth.test.ts",
    "test:google": "bun test server/googleAuth.test.ts",
    "server": "bun run server/index.ts",
    "start": "concurrently \"bun run server\" \"bun run dev\" \"bun run arc:indexer\"",
    "arc:indexer": "bun run server/arcIndexer.ts",
    "repo:check": "node scripts/repository-guard.mjs",
    "repo:prepare": "node scripts/prepare-repository.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-solana-kit": "^1.6.4",
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.3",
    "@openzeppelin/contracts": "^5.0.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.0.0",
    "@wallet-standard/app": "^1.1.1",
    "clsx": "^2.1.1",
    "connectkit": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "viem": "^2.21.19",
    "wagmi": "^2.12.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "oxlint": "^0.9.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
