NODE_ENV=production
HOST=127.0.0.1
PORT=4301
VITE_APP_URL=https://carpan.app
REFVOX_AUTH_MODE=live
REFBRIDGE_DB_PATH=/opt/carpan/shared/refbridge.db
VITE_ESCROW_ADDRESS=0x9f0fde304d80e15e57f22f1c6f15e48dd6e16a9a
VITE_ARC_RPC=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_WS_URL=wss://rpc.mainnet.arc.io
# Server-only values: populate privately on the VPS.
BLOCKSCOUT_PRO_API_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_LOGIN_ENABLED=false
ADMIN_X_IDS=
# Email login requires a verified sender and API key; mailbox ownership alone is not enough.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Carpan <info@carpan.app>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Private persistent 64-hex encryption master, generated directly on the server.
FINANCE_WEBHOOK_ENCRYPTION_KEY=
