# Carpan — Environment Variable Reference
# Copy this file to .env and fill in values. Never commit .env to version control.
# The .env file is already listed in .gitignore.

# ── Escrow Contract ───────────────────────────────────────────────────────────
# Deployed RefBridgeEscrow address on Arc Testnet (chain ID 5042002).
# Prefix with VITE_ so both the frontend (import.meta.env.VITE_ESCROW_ADDRESS)
# and the backend (process.env.VITE_ESCROW_ADDRESS) can read the same value.
VITE_ESCROW_ADDRESS=

# ── Arc Testnet RPC ───────────────────────────────────────────────────────────
# Public Arc Testnet JSON-RPC endpoint (fallback when proxy is absent).
# The RPC proxy (RPC_PROXY_BASE_URL) is preferred when Arc_Testnet is in RPC_PROXY_CHAINS.
VITE_ARC_RPC=


# ── App Public URL ────────────────────────────────────────────────────────────
# Canonical origin of the app. X and Google callbacks are built from it.
# Local preview: http://127.0.0.1:5173
# Production: use the app's public HTTPS origin.
VITE_APP_URL=http://127.0.0.1:5173

ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Blank creates a local refbridge.db. Never use production DB for tests.
REFBRIDGE_DB_PATH=

# Real wallet sign-in is the default, including when social/email are absent.
# Explicit demo selects local fixture data only (never production or public demo login).
REFVOX_AUTH_MODE=

# ── X OAuth 2.0 PKCE ─────────────────────────────────────────────────────────
# Register at https://developer.x.com/en/portal/dashboard
# Required X Developer Portal settings:
#   OAuth 2.0: ON | App type: Web App (confidential client)
#   Callback URI: http://127.0.0.1:5173/api/auth/x/callback (exact match)
#   Website URL: ${VITE_APP_URL}
#   Scope: users.read (Carpan only reads the signed-in account's identity)
# The client secret stays on the server. Do not use the SPA or Native App type.
# When absent, wallet sign-in remains available; X sign-in is unavailable.
# These are server-side secrets — do NOT prefix with VITE_.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Set false to hide/disable X sign-in while retaining credentials and sessions.
X_LOGIN_ENABLED=false

# Comma-separated numeric X user IDs permitted to approve referrals and sign
# escrow settlements (after logging in with their own X accounts). Never use
# handles; handle names can change. Required for real-mode admin access.
ADMIN_X_IDS=

# ── Google login (OpenID Connect) ─────────────────────────────────────────────
# Google Cloud Console -> Google Auth Platform -> OAuth client, Web application.
# Authorized JavaScript origin: http://127.0.0.1:5173
# Authorized redirect URI: http://127.0.0.1:5173/api/auth/google/callback
# Request only openid, email, profile. Both values stay on the server.
# Leave blank until the Google OAuth client is configured; the visible provider stays disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Passwordless email login ──────────────────────────────────────────────────
# Configure a verified sending domain and a sending-only API key at Resend.
# Without both values, the visible email form stays disabled. The
# server never returns login links to the browser; they are sent by email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Carpan <login@your-verified-domain.example>

# ── Circle RPC Proxy (Arc Studio managed) ────────────────────────────────────
# Injected automatically in the Arc Studio sandbox.
# Leave blank when running outside Arc Studio; backend falls back to VITE_ARC_RPC.
RPC_PROXY_BASE_URL=
RPC_PROXY_TOKEN=
RPC_PROXY_CHAINS=

# Blockscout PRO API (server only; required for full explorer research)
# Generate the key at https://dev.blockscout.com/dashboard
BLOCKSCOUT_PRO_API_KEY=

# Server-only Finance webhook encryption master: 32 random bytes as 64 hex characters.
# Required only for signed delivery; API keys and reads work without it.
# Keep the same value across releases and retain its private snapshot sidecars.
# Never prefix with VITE_, commit a real value, or rotate it without re-encrypting endpoint secrets.
FINANCE_WEBHOOK_ENCRYPTION_KEY=
# Alternative: a service-readable 0600 file containing the same 64-hex value.
FINANCE_WEBHOOK_ENCRYPTION_KEY_FILE=

# Owner-controlled API launch switch. Keep false until the API launch is approved.
# Does not disable Finance's internal wallet/collection operations.
CARPAN_FINANCE_API_ENABLED=false
